# Drakewears frontend env vars — copy to .env.local for local dev.
# Never commit a file with real values; .env* files are gitignored.
# Production on Vercel uses the same-origin /api route, so this stays /api.
VITE_API_URL=/api
# Google Sign-In client ID (Google Cloud Console > OAuth 2.0 Client ID for Web).
# Required for the Google button; without it the button does not render.
VITE_GOOGLE_CLIENT_ID=
