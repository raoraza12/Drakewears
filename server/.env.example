# Drakewears server env vars — copy to server/.env for local dev.
# Never commit a file with real values; .env* files are gitignored.
NODE_ENV=development
PORT=5000
# Public URL of the deployed frontend (extra CORS allowlist entry).
# Example: https://drakewears.vercel.app
CLIENT_URL=
# PostgreSQL connection string for Prisma. REQUIRED — the server cannot start without it.
DATABASE_URL=postgresql://user:password@host:5432/drakewears
# Direct (non-pooled) Postgres URL. Only needed when DATABASE_URL is a pooled
# connection (e.g. Supabase PgBouncer); leave empty otherwise.
DIRECT_URL=
# Secret used to sign JWTs (login + password-reset tokens). REQUIRED.
# Use a long random string; changing it invalidates all existing tokens.
JWT_SECRET=
# Cloudinary image uploads (admin product images + payment receipts).
# Required for uploads to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP email notifications (order emails to admin + customer).
# Optional — the mailer is disabled when SMTP_PASS is missing.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
FROM_EMAIL=
# Admin account password used by server/update_admin.js and server/seed.js.
# REQUIRED to create or reset the admin user. Never commit a real password.
ADMIN_PASSWORD=
# Test user password used only by server/seed.js. Optional.
SEED_TEST_PASSWORD=
